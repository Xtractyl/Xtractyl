# ===== Postgres =====
POSTGRES_CONTAINER_NAME=postgres
POSTGRES_DB=dbname
POSTGRES_USER=username
POSTGRES_PASSWORD=yourpassword
POSTGRES_PORT=5432 #you can change this
POSTGRES_INTERNAL_PORT=5432 #do not change this!
POSTGRES_SERVICE_NAME=postgres
PGDATA_VOLUME=pgdata

# ===== Label Studio =====
LABELSTUDIO_CONTAINER_NAME=labelstudio
LABELSTUDIO_PORT=8080
LABELSTUDIO_DATA_VOLUME=labelstudio_data
DJANGO_DB=default

# ===== MinIO =====
MINIO_CONTAINER_NAME=minio
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=yourpassword
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_DATA_VOLUME=minio_data

# ===== Conversion =====
MINIO_BUCKET=xtractyl
MINIO_PRESIGN_EXPIRY_SECONDS=3600
REDIS_PUSH_MAX_RETRIES=3
REDIS_PUSH_RETRY_DELAY_SECONDS=0.5

# ===== pgAdmin =====
PGADMIN_CONTAINER_NAME=pgadmin
PGADMIN_EMAIL=admin@xtractyl.internal
PGADMIN_PASSWORD=yourpassword
PGADMIN_PORT=5050

# ===== Postgres Xtractyl =====
POSTGRES_XTRACTYL_CONTAINER_NAME=postgres_xtractyl
POSTGRES_XTRACTYL_DB=xtractyl
POSTGRES_XTRACTYL_USER=xtractyl # if changed, update pgadmin/servers.json and delete pgadmin volume
POSTGRES_XTRACTYL_PASSWORD=yourpassword
POSTGRES_XTRACTYL_PORT=5433
PGDATA_XTRACTYL_VOLUME=pgdata_xtractyl

# ===== Orchestrator =====
ORCH_CONTAINER_NAME=orchestrator
ORCH_PORT=5001
ORCH_APP_DIR=./orchestrator

# ===== ML Backend =====
ML_BACKEND_CONTAINER_NAME=ml_backend
ML_BACKEND_PORT=6789
ML_BACKEND_INTERNAL_PORT=6789

# ===== Ollama =====
OLLAMA_CONTAINER_NAME=ollama
OLLAMA_PORT=11434
OLLAMA_MODELS_VOLUME=ollama_models

# ===== Docling =====
DOCLING_CONTAINER_NAME=docling
DOCLING_PORT=5004
FONTCACHE_VOLUME=fontcache
XDG_CACHE_VOLUME=xdg_cache
XDG_DATA_VOLUME=xdg_data
XDG_CACHE_HOME=/root/.cache
XDG_DATA_HOME=/root/.local/share

# ===== Frontend =====
FRONTEND_PORT=5173
ROLLUP_USE_NODE_BUILTINS=true

# ===== Job Queue / Worker =====
JOB_QUEUE_CONTAINER_NAME=job_queue
REDIS_HOST=job_queue
REDIS_PORT=6379
REDIS_DATA_VOLUME=redis_data
WORKER_PRELABEL_CONTAINER_NAME=worker_prelabel

# ===== Cleanup =====
CLEANUP_CONTAINER_NAME=cleanup

# ---------- Timeout & Conversion ----------
# How many seconds the Worker Docling connection per file is held before a timeout is reached
WORKER_DOCLING_TIMEOUT_SECONDS=300
# How many seconds the Docling subprocess has for conversion of a single PDF (DOCLING_CONVERT_TIMEOUT_SECONDS < WORKER_DOCLING_TIMEOUT_SECONDS)
DOCLING_CONVERT_TIMEOUT_SECONDS=240

# ---------- Timeout & Tuning ----------
# How many seconds the LLM may take to respond per single question for a single HTML file
LLM_TIMEOUT=120

# Additional overhead (in seconds) per question and HTML,
# accounting for localisation of the LLM’s answer inside the HTML document
LLM_OVERHEAD=10

# Fixed margin (in seconds) for network latency and writing predictions to Label Studio
UPLOAD_MARGIN=30

# Maximum time (in seconds) to wait for Label Studio to update its database
# after a prediction has been sent
POLL_TIMEOUT=1800

# How often (in seconds) to check Label Studio for saved predictions
POLL_INTERVAL=2

# Context size for LLM
LLM_NUM_CTX=4096

# ===== Logging =====
LOGS_DIR=./logs
DEV_LOGS_DIR=./data/logs

# ===== Cleaning =====
# How long to wait, in seconds, between checks for stale conversion jobs
CLEANUP_INTERVAL_SECONDS=3600
# How old (in hours) a conversion job must be — since creation for "pending",
# or since the last update for "converting"/"failed" — before the cleanup
# service removes it and its associated MinIO files
CLEANUP_STALE_AFTER_HOURS=2
